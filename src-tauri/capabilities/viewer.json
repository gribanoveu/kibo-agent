{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "viewer",
  "description": "A Markdown file opened with the app: it reads its file, opens web links and drives its own window, nothing more",
  "windows": ["viewer-*"],
  "permissions": [
    "core:default",
    "allow-viewer-file",
    "allow-viewer-text-scale-get",
    "allow-viewer-text-scale-set",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "opener:default"
  ]
}
