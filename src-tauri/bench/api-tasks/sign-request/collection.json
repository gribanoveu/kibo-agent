{
  "info": {
    "name": "Payments",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "id": "payment-create",
      "name": "Create payment",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/payments",
        "body": {
          "mode": "raw",
          "raw": "{\"sum\": 120, \"currency\": \"EUR\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ]
}
